{
  "rules": {
    ".read": true,
    ".write": true,

    "stock": {
      "$branchId": {
        "$palletId": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },

    "transactions": {
      ".indexOn": ["docNo", "date", "status"],
      "$txKey": {
        "id": { ".validate": "newData.isNumber()" },
        "qty": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "docNo": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "status": { ".validate": "newData.val() === 'PENDING' || newData.val() === 'COMPLETED' || newData.val() === 'CANCELLED'" },
        "type": { ".validate": "newData.val() === 'IN' || newData.val() === 'OUT' || newData.val() === 'MAINTENANCE' || newData.val() === 'ADJUST' || newData.val() === 'SCRAP_SALE' || newData.val() === 'SCRAP_DISCARD'" },
        "source": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "dest": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "driverName": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "carRegistration": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "transportCompany": { ".validate": "newData.isString() && newData.val().length <= 150" },
        "referenceDocNo": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "adjustedBy": { ".validate": "newData.isString() && newData.val().length <= 100" }
      }
    },

    "palletRequests": {
      ".indexOn": ["requestNo", "status", "branchId"],
      "$reqKey": {
        "requestNo": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "status": { ".validate": "newData.val() === 'PENDING' || newData.val() === 'APPROVED' || newData.val() === 'SHIPPED' || newData.val() === 'REJECTED'" },
        "priority": { ".validate": "newData.val() === 'NORMAL' || newData.val() === 'URGENT'" },
        "purpose": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 500" }
      }
    },

    "config": {
      "telegramChatId": { ".validate": "newData.isString() && newData.val().length <= 40" }
    },

    "thresholds": {
      "$branchId": {
        "$palletId": {
          "min": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "max": { ".validate": "newData.isNumber() && newData.val() >= 0" }
        }
      }
    }
  }
}
