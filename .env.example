# ===================================================================
# ตัวอย่างไฟล์ตั้งค่า — คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
#
#   cp .env.example .env.local
#
# .env.local จะไม่ถูก commit ขึ้น git (ถูก ignore ด้วย *.local)
# ห้ามใส่ค่าจริงลงในไฟล์ .env.example นี้เด็ดขาด
# ===================================================================

# -------------------------------------------------------------------
# Telegram Bot — ใช้ส่งการแจ้งเตือนการเคลื่อนย้ายพาเลท
# -------------------------------------------------------------------
# วิธีขอ token: เปิด Telegram → ค้นหา @BotFather → /mybots → เลือกบอท
#                → API Token
#
# ถ้าไม่ใส่ค่านี้ ระบบจะทำงานได้ปกติ แต่จะไม่ส่งการแจ้งเตือน
#
# ⚠️ ห้ามใส่ VITE_ นำหน้าเด็ดขาด
#    Vite จะฝังตัวแปรที่ขึ้นต้นด้วย VITE_ ลงในไฟล์ JS ที่ส่งให้เบราว์เซอร์
#    ผู้ใช้เปิด DevTools แล้วอ่าน token ได้ทันที
#    ตัวแปรนี้ถูกอ่านโดย api/telegram/send.ts ซึ่งรันบนเซิร์ฟเวอร์เท่านั้น
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# รายการแชทที่อนุญาตให้ส่งข้อความเข้าได้ (คั่นด้วยจุลภาค ไม่ต้องเว้นวรรค)
#
# ⚠️ จำเป็นต้องตั้ง มิฉะนั้นระบบจะปฏิเสธการส่งทั้งหมด (ปิดไว้ก่อนปลอดภัยกว่า)
#    เพราะ /api/telegram/send เป็น endpoint สาธารณะ ถ้าไม่ล็อกปลายทาง
#    ใครก็ตามที่เห็น request ใน DevTools จะใช้บอทส่งข้อความเข้าแชทอื่นได้
#
# หา chat id ได้จากค่า config.telegramChatId ในฐานข้อมูล
# ตัวอย่างกลุ่ม: -1001234567890  (กลุ่มจะขึ้นต้นด้วย -100)
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890

# -------------------------------------------------------------------
# Google Gemini API — ใช้กับผู้ช่วย AI ในระบบ
# -------------------------------------------------------------------
# ขอ API key ได้ที่ https://aistudio.google.com/app/apikey
# ถ้าไม่ใส่ ฟีเจอร์ AI จะไม่ทำงาน แต่ส่วนอื่นใช้ได้ปกติ
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------------
# ข้อมูลแอปพลิเคชัน
# -------------------------------------------------------------------
VITE_APP_NAME="Neo Siam Logistics - Pallet Management"
VITE_APP_VERSION=1.0.0
