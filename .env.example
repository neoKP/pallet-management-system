# ===================================================================
# ตัวอย่างไฟล์ตั้งค่า — คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
#
#   cp .env.example .env.local
#
# .env.local จะไม่ถูก commit ขึ้น git (ถูก ignore ด้วย *.local)
# ห้ามใส่ค่าจริงลงในไฟล์ .env.example นี้เด็ดขาด
# ===================================================================

# -------------------------------------------------------------------
# Telegram Bot — ใช้ส่งการแจ้งเตือนการเคลื่อนย้ายพาเลท
# -------------------------------------------------------------------
# วิธีขอ token: เปิด Telegram → ค้นหา @BotFather → /mybots → เลือกบอท
#                → API Token
#
# ถ้าไม่ใส่ค่านี้ ระบบจะทำงานได้ปกติ แต่จะไม่ส่งการแจ้งเตือน
#
# ⚠️ คำเตือน: ค่านี้จะถูกฝังลงไฟล์ JS ตอน build ผู้ใช้เปิด DevTools
#    แล้วอ่านได้ ถือว่าเป็นความลับระดับ "กันหลุดเข้า git" เท่านั้น
#    ดูแผนแก้ที่ปลอดภัยกว่าใน docs/TELEGRAM_TOKEN_MIGRATION.md
VITE_TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -------------------------------------------------------------------
# Google Gemini API — ใช้กับผู้ช่วย AI ในระบบ
# -------------------------------------------------------------------
# ขอ API key ได้ที่ https://aistudio.google.com/app/apikey
# ถ้าไม่ใส่ ฟีเจอร์ AI จะไม่ทำงาน แต่ส่วนอื่นใช้ได้ปกติ
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------------
# ข้อมูลแอปพลิเคชัน
# -------------------------------------------------------------------
VITE_APP_NAME="Neo Siam Logistics - Pallet Management"
VITE_APP_VERSION=1.0.0
